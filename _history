\"205\" y=\"0\"></block></xml>"]]}]},{"type":"edited","filename":"main.ts","patch":[{"start1":0,"length1":54,"diffs":[[1,"basic.forever(function on_forever() {\n    \n})\n"]]}]},{"type":"edited","filename":"main.py","patch":[{"start1":0,"length1":0,"diffs":[[1,"# MakeCode Python (not standalone MicroPython)\n# Hardware: right motor M1, left motor M2;\n# sonar port 1 (candidate: Trig P1, Echo P2);\n# downward IR port 2 (candidate: left P13, right P12).\n# First test with wheels OFF the ground, then on a wide flat floor.\n# A+B = calibrate ground while stopped; A = start; B = stop.\n"]]},{"start1":321,"length1":57,"diffs":[[1,"running = False\ncalibrated = False\nbase_left = 0\nbase_right = 0\nphase = 0       # 0 cruise, 1 retreat, 2 turn\nphase_end = 0\nturn_way = 0    # 0 left, 1 right\n\n# Change either value from 1 to -1 if that wheel spins backward.\nLEFT_DIR = 1\nRIGHT_DIR = 1\n\n\ndef drive(left: number, right: number):\n    # Physical left = M2 (library enum RIGHT = channel 2)\n    makerobo.motor_run(makerobo.Motors.RIGHT, left * LEFT_DIR)\n    # Physical right = M1 (library enum LEFT = channel 1)\n    makerobo.motor_run(makerobo.Motors.LEFT, right * RIGHT_DIR)\n\n\ndef stop_car():\n    makerobo.motor_stop_all()\n\n\ndef sonar_cm():\n    # Port 1 carries P1/P2; verify sensor signal order.\n    pins.digital_write_pin(DigitalPin.P1, 0)\n    control.wait_micros(3)\n    pins.digital_write_pin(DigitalPin.P1, 1)\n    control.wait_micros(10)\n    pins.digital_write_pin(DigitalPin.P1, 0)\n    pulse = pins.pulse_in(DigitalPin.P2, PulseValue.HIGH, 25000)\n    if pulse <= 0:\n        return -1\n    return pulse / 58\n\n\ndef start_avoid(turn_right: number):\n    global phase, phase_end, turn_way\n    turn_way = turn_right\n    phase = 1\n    stop_car()\n    drive(-80, -80)\n    phase_end = input.running_time() + 250\n\n\ndef on_button_pressed_ab():\n    global running, calibrated, base_left, base_right, phase\n    running = False\n    phase = 0\n    stop_car()\n    pins.set_pull(DigitalPin.P13, PinPullMode.PULL_UP)\n    pins.set_pull(DigitalPin.P12, PinPullMode.PULL_UP)\n    base_left = pins.digital_read_pin(DigitalPin.P13)\n    base_right = pins.digital_read_pin(DigitalPin.P12)\n    calibrated = True\n    basic.show_icon(IconNames.YES)\ninput.on_button_pressed(Button.AB, on_button_pressed_ab)\n\n\ndef on_button_pressed_a():\n    global running, phase\n    if not calibrated:\n        basic.show_string(\"C\")\n    elif sonar_cm() < 0:\n        running = False\n        stop_car()\n        basic.show_string(\"?\")\n    else:\n        phase = 0\n        running = True\n        basic.show_icon(IconNames.HAPPY)\ninput.on_button_pressed(Button.A, on_button_pressed_a)\n\n\ndef on_button_pressed_b():\n    global running, phase\n    running = False\n    phase = 0\n    stop_car()\n    basic.show_icon(IconNames.NO)\ninput.on_button_pressed(Button.B, on_button_pressed_b)\n\n\ndef on_forever():\n    global running, phase, phase_end\n    if not running:\n        basic.pause(80)\n    elif phase == 1:"]]}]}]},{"timestamp":1794830846059,"editorVersion":"9.0.12","changes":[{"type":"edited","filename":"main.py","patch":[{"start1":0,"length1":226,"diffs":[[1,""]]},{"start1":27,"length1":110,"diffs":[[1,"basic.show_icon(IconNames.YES)\n"]]}]}]},{"timestamp":1794872972072,"editorVersion":"9.0.12","changes":[{"type":"edited","filename":"main.ts","patch":[{"start1":0,"length1":188,"diffs":[[1,""]]},{"start1":24,"length1":103,"diffs":[[1,"basic.showIcon(IconNames.Yes)\n"]]}]}]},{"timestamp":1794872972145,"editorVersion":"9.0.12","changes":[{"type":"edited","filename":"main.blocks","patch":[{"start1":0,"length1":696,"diffs":[[1,"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables><variable id=\"/U:$8Q_fyq|3O9sSXO_r\">LEFT_DIR</variable><variable id=\",**Yc-}@BA+f]iV8x+ML\">RIGHT_DIR</variable><variable id=\"J4Rz`plJ[bGYE[FSYQzM\">pulse</variable><variable id=\"i|5B*0.44Dd7%4yDD98Q\">turn_way</variable><variable id=\"MWHt/0!Xz$D9f}YP)}K9\">pha